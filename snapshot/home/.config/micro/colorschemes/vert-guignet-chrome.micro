# vert-guignet-chrome: micro colorscheme generated from themes/chrome-vertguignet.json
# Do not edit by hand: regenerate with generate-colorschemes.py

color-link default "#222222,#FBF9F6"
color-link comment "italic #989898"
color-link constant.string "#cc33cc"
color-link constant.specialChar "#cc33cc"
color-link constant.number "#9f1bf1"
color-link constant.bool "#9f1bf1"
color-link identifier "bold #006600"
color-link identifier.var "bold #006600"
color-link identifier.class "#b18534"
color-link statement "bold #762625"
color-link type "bold #8f200f"
color-link preproc "#222222"
color-link special "bold #2265ad"
color-link symbol "#222222"
color-link symbol.operator "#0f95b0"
color-link todo "italic #989898"

color-link underlined "underline #4b5f2d"
color-link error "bold #c43d3d"
color-link error-message "bold #c43d3d,#FBF9F6"
color-link message "#3a3a31,#f3f1e9"
color-link hlsearch "#222222,#248067"
color-link selection ",#97b8a7"
color-link cursor-line "#eeedea,#222222"
color-link current-line-number "bold #4b5f2d,#eeedea"
color-link line-number "#98a099"
color-link color-column ",#EAEAE5"
color-link indent-char "#c5d6c7"
color-link divider "#c5d6c7"
color-link scrollbar "#98a099"
color-link statusline "#555555,#EAEAE5"
color-link tabbar "#555555,#EAEAE5"
color-link tabbar.active "bold #4b5f2d,#FBF9F6"
color-link gutter-error "#c43d3d"
color-link gutter-warning "#a66f00"
color-link gutter-info "#28658f"
color-link ignore "#98a099"
color-link diff-added "#3b9b62"
color-link diff-modified "#a66f00"
color-link diff-deleted "#c84f4f"
color-link cursor "#253d24"
