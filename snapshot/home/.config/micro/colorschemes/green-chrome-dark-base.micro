# green-chrome-dark-base: micro colorscheme generated from themes/chrome-green-base-dark.json
# Do not edit by hand: regenerate with generate-colorschemes.py

color-link default "#e0e4da,#232720"
color-link comment "italic #9da299"
color-link constant.string "#f07171"
color-link constant.specialChar "#f07171"
color-link constant.number "#c394e8"
color-link constant.bool "#c394e8"
color-link identifier "#edf0d2"
color-link identifier.var "#edf0d2"
color-link identifier.class "#87b2bd"
color-link statement "bold #d7945e"
color-link type "#c57636"
color-link preproc "#e0e4da"
color-link special "#f3c69b"
color-link symbol "#e0e4da"
color-link symbol.operator "bold #d7945e"
color-link todo "italic #9da299"

color-link underlined "underline #207f4c"
color-link error "bold #c43d3d"
color-link error-message "bold #c43d3d,#232720"
color-link message "#e0e4da,#232720"
color-link hlsearch "#e0e4da,#3ba776"
color-link selection ",#45624b"
color-link cursor-line "#2e322b,#e0e4da"
color-link current-line-number "bold #207f4c,#2e322b"
color-link line-number "#98a099"
color-link color-column ",#313f2b"
color-link indent-char "#3d4d3d"
color-link divider "#3d4d3d"
color-link scrollbar "#98a099"
color-link statusline "#c4c8be,#313f2b"
color-link tabbar "#c4c8be,#313f2b"
color-link tabbar.active "bold #207f4c,#232720"
color-link gutter-error "#c43d3d"
color-link gutter-warning "#a66f00"
color-link gutter-info "#28658f"
color-link ignore "#98a099"
color-link diff-added "#3b9b62"
color-link diff-modified "#a66f00"
color-link diff-deleted "#c84f4f"
color-link cursor "#b8e8c2"
